generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int          @id @default(autoincrement())
  nama       String
  email      String       @unique
  password   String
  role       Role         @default(USER)
  isActive   Boolean      @default(true) @map("is_active")
  tokenVersion Int        @default(0) @map("token_version")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  auditLogs  AuditLog[]
  invoices   Invoice[]
  notifikasi Notifikasi[]

  @@map("users")
}

model Notifikasi {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  judul     String
  pesan     String   @db.Text
  tipe      String
  invoiceId Int?     @map("invoice_id")
  dibaca    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifikasi")
}

model Elektronik {
  id               Int           @id @default(autoincrement())
  nomorSbg         String        @unique @map("nomor_sbg")
  vendor           String?       // vendor/asal barang (mis. GMN, GMS, EKSTERNAL) — informatif saja
  grade            Grade
  jenisBarang      String        @map("jenis_barang")
  detailBarang     String        @map("detail_barang")
  keterangan       String?       @db.Text
  cogs             Decimal       @db.Decimal(15, 2)
  // Override harga jual (opsional, dari import Excel). NULL = dihitung otomatis dari COGS.
  hjMin            Decimal?      @map("hj_min") @db.Decimal(15, 2)
  hjMax            Decimal?      @map("hj_max") @db.Decimal(15, 2)
  hargaSmt         Decimal?      @map("harga_smt") @db.Decimal(15, 2)
  offeringPengepul Decimal?      @map("offering_pengepul") @db.Decimal(15, 2)
  hargaJual        Decimal?      @map("harga_jual") @db.Decimal(15, 2)
  ppn              Decimal?      @db.Decimal(15, 2)
  totalHarga       Decimal?      @map("total_harga") @db.Decimal(15, 2)
  profit           Decimal?      @db.Decimal(15, 2)
  status           StatusBarang  @default(BELUM_TERJUAL)
  perusahaan       Perusahaan    @default(SERBA_MAS)
  tanggalLelang    DateTime?     @map("tanggal_lelang")
  tanggalMasuk     DateTime      @default(now()) @map("tanggal_masuk")
  // ── Data penjualan langsung (struk) ──
  tanggalJual      DateTime?     @map("tanggal_jual")
  namaPelanggan    String?       @map("nama_pelanggan")
  noTelepon        String?       @map("no_telepon")
  namaSales        String?       @map("nama_sales")
  jenisPembeli     JenisPembeli? @map("jenis_pembeli")
  nomorStruk       String?       @map("nomor_struk")
  // M-03: pencatat penjual (user yg melakukan penjualan). Dipakai agar role non-admin
  // hanya melihat data pribadi pelanggan dari penjualan miliknya sendiri.
  soldById         Int?          @map("sold_by_id")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  invoiceItems     InvoiceItem[]

  @@index([status])
  @@index([perusahaan])
  @@index([grade])
  @@index([tanggalMasuk])
  @@index([tanggalLelang])
  @@index([tanggalJual])
  @@index([nomorStruk])
  @@index([soldById])
  @@map("elektronik")
}

enum JenisPembeli {
  KARYAWAN_INTERNAL
  EKSTERNAL
  PENGEPUL
}

model Invoice {
  id             Int           @id @default(autoincrement())
  nomorInvoice   String        @unique @map("nomor_invoice")
  namaCustomer   String        @map("nama_customer")
  noTelepon      String?       @map("no_telepon")
  tanggalInvoice DateTime      @map("tanggal_invoice")
  perusahaan     Perusahaan    @default(SERBA_MAS)
  status         InvoiceStatus @default(DRAFT)
  catatan        String?       @db.Text
  approvedById   Int?          @map("approved_by_id")
  approvedByNama String?       @map("approved_by_nama")
  approvedAt     DateTime?     @map("approved_at")
  rejectedAt     DateTime?     @map("rejected_at")
  rejectedReason String?       @map("rejected_reason") @db.Text
  printedAt      DateTime?     @map("printed_at")
  createdById    Int           @map("created_by_id")
  createdBy      User          @relation(fields: [createdById], references: [id])
  items          InvoiceItem[]
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdById])
  @@map("invoices")
}

model InvoiceItem {
  id           Int        @id @default(autoincrement())
  invoiceId    Int        @map("invoice_id")
  invoice      Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  elektronikId Int        @map("elektronik_id")
  elektronik   Elektronik @relation(fields: [elektronikId], references: [id])
  nomorSbg     String     @map("nomor_sbg")
  jenisBarang  String     @map("jenis_barang")
  detailBarang String     @map("detail_barang")
  hargaJual    Decimal    @map("harga_jual") @db.Decimal(15, 2)
  ppn          Decimal    @db.Decimal(15, 2)
  totalHarga   Decimal    @map("total_harga") @db.Decimal(15, 2)

  @@map("invoice_items")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  namaUser  String?  @map("nama_user")
  aktivitas String
  tabel     String?
  dataLama  Json?    @map("data_lama")
  dataBaru  Json?    @map("data_baru")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

enum Role {
  ADMIN
  SUPER_USER
  USER
  KATALOG_USER
}

enum Grade {
  A
  B
  C
  D
}

enum StatusBarang {
  BELUM_TERJUAL
  TERJUAL
}

enum InvoiceStatus {
  DRAFT
  WAITING_APPROVAL
  APPROVED
  REJECTED
  PRINTED
  CANCELLED
}

enum Perusahaan {
  VOLARY
  SERBA_MAS
}

model Cabang {
  id        Int           @id @default(autoincrement())
  nama      String
  alamat    String?       @db.Text
  storeName String?       @map("store_name") // Nama toko di API SERBAMAS (StoreName), untuk sinkronisasi stok
  aktif     Boolean       @default(true)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  katalog   KatalogEmas[]

  @@map("cabang")
}

model KatalogEmas {
  id           Int          @id @default(autoincrement())
  cabangId     Int?         @map("cabang_id")
  cabang       Cabang?      @relation(fields: [cabangId], references: [id])
  kategori     KategoriEmas
  jenisBarang  String       @map("jenis_barang")
  nama         String
  deskripsi    String?      @db.Text
  harga        Decimal      @db.Decimal(15, 2)
  gambar       String?      @db.Text
  tersedia     Boolean      @default(true)
  urutan       Int          @default(0)
  // ── Sinkronisasi dengan API toko SERBAMAS ──
  sumber       String       @default("MANUAL") // MANUAL = input tangan, API = hasil sinkron toko
  externalId   String?      @map("external_id") // Kode/ID unik barang di sistem toko (untuk cocokkan & deteksi stok habis)
  stok         Int? // Jumlah stok terakhir dari toko (jika tersedia di API)
  lastSyncedAt DateTime?    @map("last_synced_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@unique([cabangId, externalId], name: "cabang_external")
  @@index([sumber])
  @@map("katalog_emas")
}

enum KategoriEmas {
  PERHIASAN
  LM
}

// ── Barang ART (Logam Mulia & Perhiasan) ──
// Satu tabel dipakai dua sub-fitur, dibedakan oleh `kategori`.
model BarangArt {
  id          Int          @id @default(autoincrement())
  kategori    KategoriArt
  barangAsal  String       @default("") @map("barang_asal") // (deprecated) tidak dipakai lagi di UI; dipertahankan utk baris lama
  vendorAsal  String?      @map("vendor_asal") // vendor/pegadaian asal (Gadai Mas/Gadai Mulia) → dasar Kode Barang
  nomorSbg    String       @map("nomor_sbg")
  provinsi    String
  namaBarang  String       @map("nama_barang")
  gramasi     Decimal      @db.Decimal(12, 3)
  karat       String
  totalHarga  Decimal?     @map("total_harga") @db.Decimal(15, 2) // nilai lelang sebelum bea
  beaLelang   Decimal?     @map("bea_lelang") @db.Decimal(15, 2) // bea lelang
  cogs        Decimal      @db.Decimal(15, 2) // = Payment SMT (Total Harga + Bea Lelang) → modal/COGS
  kodeBarang  String?      @map("kode_barang") // null utk Perhiasan aktif; LMN/LMS utk Logam Mulia; EKS saat masuk Barang Eksport
  tahap       TahapArt     @default(AKTIF) // lokasi/siklus: AKTIF | EKSPORT | TERJUAL | DILEBUR
  tanggalJual DateTime?    @map("tanggal_jual") // terisi hanya bila sudah terjual
  nominalJual Decimal?     @map("nominal_jual") @db.Decimal(15, 2) // terisi hanya bila sudah terjual
  vendor      String? // vendor pembeli, diisi saat tandai terjual
  nomorSku    String?      @map("nomor_sku") // satu SKU bisa dipakai banyak barang dalam 1 penjualan
  tanggalLebur   DateTime? @map("tanggal_lebur") // terisi bila perhiasan dilebur
  tanggalEksport DateTime? @map("tanggal_eksport") // terisi bila dipindah ke Barang Eksport
  gambar      String?      @db.Text // URL/path foto barang (dipakai di Barang Eksport)
  keterangan  String?      @db.Text
  status      StatusBarang @default(BELUM_TERJUAL)
  cukimId     Int?         @map("cukim_id") // terisi bila barang ini ikut dilebur menjadi sebuah Cukim
  cukim       Cukim?       @relation(fields: [cukimId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // Catatan: satu No SBG (surat gadai) bisa memuat banyak barang → nomorSbg TIDAK unik.
  @@index([kategori])
  @@index([status])
  @@index([tahap])
  @@index([nomorSku])
  @@index([nomorSbg])
  @@index([kodeBarang])
  @@index([cukimId])
  @@map("barang_art")
}

// Cukim = gumpalan emas hasil lebur. Dibuat saat barang perhiasan dilebur:
// beberapa barang digabung jadi 1 Cukim. COGS = total Payment SMT barang yang dilebur.
// Barang asal tetap tersimpan sebagai History (tahap DILEBUR) dan terhubung via BarangArt.cukimId.
model Cukim {
  id         Int         @id @default(autoincrement())
  noCukim    String      @unique @map("no_cukim") // CKM## (nomor berjalan, tak dipakai ulang)
  berat      Decimal     @db.Decimal(12, 3) // berat cukim (gram), diisi manual saat lebur
  kadarXrf   String      @map("kadar_xrf") // kadar hasil uji XRF (teks bebas, mis. "99.9%")
  cogs       Decimal      @db.Decimal(15, 2) // = total Payment SMT barang yang dilebur
  tanggal    DateTime? // tanggal lebur / pembuatan cukim
  keterangan String?      @db.Text
  status     StatusBarang @default(BELUM_TERJUAL) // BELUM_TERJUAL (aktif) | TERJUAL (history)
  tanggalJual DateTime?   @map("tanggal_jual") // terisi bila cukim terjual
  nominalJual Decimal?    @map("nominal_jual") @db.Decimal(15, 2) // harga jual cukim
  vendor     String? // vendor/pembeli, diisi saat tandai terjual
  nomorSku   String?      @map("nomor_sku")
  items      BarangArt[] // barang asal yang dilebur menjadi cukim ini
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@index([status])
  @@map("cukim")
}

enum KategoriArt {
  LOGAM_MULIA
  PERHIASAN
}

enum TahapArt {
  AKTIF // masih di daftar Logam Mulia / Perhiasan
  EKSPORT // dipindah ke Barang Eksport (perhiasan bagus)
  TERJUAL // sudah terjual → History
  DILEBUR // perhiasan dilebur → History
}

// Penghitung nomor berjalan Kode Barang per prefix (LMN/LMS/EKS).
// lastNumber HANYA bertambah → nomor tidak pernah dipakai ulang, bahkan setelah
// barang terjual, dipindah, atau dihapus.
model KodeCounter {
  prefix     String @id
  lastNumber Int    @default(0) @map("last_number")

  @@map("kode_counter")
}
